api.array :note_templates do
  note_templates.each do |template|
    api.template do
      api.id template.id
      api.tracker_id template.tracker_id
      api.tracker_name template.tracker.try(:name)
      api.name template.name
      api.description template.description
      api.enabled template.enabled
      api.created_on template.created_at
      api.updated_on template.updated_at
    end
  end
end
